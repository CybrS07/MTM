{
  "name": "mind-to-machine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
  "dev": "concurrently -k -n api,web \"npm:api\" \"npm:web\"",
  "api": "tsx watch api/src/index.ts",
  "web": "vite",
  "plan": "tsx api/src/cli.ts run",
  "update": "tsx api/src/cli.ts update",
  "typecheck": "tsc --noEmit && tsc --noEmit -p api",
  "test": "tsx --test api/test/core.test.ts",
  "build": "vite build"
},
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
