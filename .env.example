# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# ---- Gemini ----
# No key goes in this file. Each user pastes their own free token (https://aistudio.google.com/apikey) into the app; it stays in their browser.

# ---- Supabase (optional: leave empty for no-login mode) ----
# Browser side: public values only. Same project as above. Leave empty to run the web app in no-login mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
