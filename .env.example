# Copy this file to .env and fill it in. .env is git-ignored. Never commit real keys.

# ---- Model (the only paid or rate-limited part). Free key: https://aistudio.google.com/apikey ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Local API server ----
HTTPS_PORT=8443
HTTP_PORT=8080
WEB_ORIGIN=https://localhost:5173

# ---- Login ----
# false = no login needed (local use, hackathon test run). The web app then opens straight to the plan.
# true  = organizers and students sign in with an emailed code (needs the Supabase values below). Use true when you deploy.
REQUIRE_LOGIN=false

# ---- Supabase (optional while REQUIRE_LOGIN=false) ----
# Server side: secret key stays here, never in a VITE_ variable.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Browser side: public values only. Same project as above. Leave empty to run the web app in no-login mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only for a deployed site (GitHub Pages): the https address of your API. Leave empty for local dev.
VITE_API_URL=
